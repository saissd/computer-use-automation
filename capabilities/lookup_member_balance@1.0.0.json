{
  "schema_version": "1.0",
  "id": "lookup_member_balance",
  "name": "Look up a member's regular savings balance",
  "version": "1.0.0",
  "status": "approved",
  "description": "Given a member number, open the member relationship summary in the Meridian core banking console and return the member's name and current Regular Savings balance.",
  "target": {
    "app_id": "meridian-core-membersvc",
    "surface": "legacy_web",
    "entry": "http://127.0.0.1:8099/",
    "variant": "training"
  },
  "inputs": [
    {
      "name": "member_id",
      "type": "string",
      "required": true,
      "description": "Institution member number, 4-9 digits.",
      "pattern": "\\d{4,9}",
      "example": "12345",
      "sensitivity": "pii"
    }
  ],
  "outputs": [
    {
      "name": "member_name",
      "type": "string",
      "from_step": "extract_name",
      "required": true,
      "description": "Member's full name as shown on the relationship summary."
    },
    {
      "name": "savings_balance",
      "type": "money",
      "from_step": "extract_balance",
      "required": true,
      "description": "Current balance of the Regular Savings share, as displayed."
    }
  ],
  "risk": {
    "class": "read_only",
    "requires_approval": false,
    "rationale": "Pure lookup. No application state is modified, so unattended replay is safe."
  },
  "preconditions": [],
  "steps": [
    {
      "id": "open_console",
      "intent": "Open the Member Services console and wait for the search form",
      "action": "navigate",
      "url": "http://127.0.0.1:8099/",
      "extract_kind": "text",
      "post_assert": {
        "kind": "element_present",
        "role": "textbox",
        "name": "Member Number",
        "case_sensitive": false
      },
      "on_error": [
        {
          "when": {
            "kind": "text_present",
            "text": "Scheduled maintenance",
            "case_sensitive": false
          },
          "do": "dismiss",
          "target": {
            "primary": {
              "by": "role_name",
              "role": "button",
              "name": "Acknowledge",
              "offset": 1,
              "exact": false
            },
            "fallbacks": []
          },
          "max_attempts": 2,
          "wait_ms": 1000,
          "note": "Known maintenance interstitial. Expected noise, not a failure."
        },
        {
          "when": {
            "kind": "text_present",
            "text": "Your session has expired",
            "case_sensitive": false
          },
          "do": "reauth",
          "max_attempts": 1,
          "wait_ms": 1000,
          "note": "Idle timeout. Re-establish the application session and retry once."
        },
        {
          "when": {
            "kind": "text_present",
            "text": "Server Error in",
            "case_sensitive": false
          },
          "do": "fail",
          "max_attempts": 2,
          "wait_ms": 1000,
          "note": "Unhandled application error. Not recoverable and not a business answer."
        }
      ],
      "timeout_ms": 15000,
      "retries": 1
    },
    {
      "id": "enter_member",
      "intent": "Type the member number into the search field",
      "action": "type",
      "target": {
        "primary": {
          "by": "role_name",
          "role": "textbox",
          "name": "Member Number",
          "offset": 1,
          "exact": true
        },
        "fallbacks": [
          {
            "by": "text_near",
            "anchor": "Member Number",
            "direction": "right",
            "offset": 1,
            "exact": false
          },
          {
            "by": "css",
            "selector": "#ctl00_ContentPlaceHolder1_txtMbrNo",
            "offset": 1,
            "exact": false
          }
        ],
        "scope": {
          "frame_path": [
            "content"
          ]
        },
        "captured": {
          "role": "textbox",
          "name": "Member Number",
          "tag": "input",
          "recorded_html_snippet": "<input type=text name=member_no title='Member Number'>"
        }
      },
      "value": "{{member_id}}",
      "extract_kind": "text",
      "on_error": [
        {
          "when": {
            "kind": "text_present",
            "text": "Scheduled maintenance",
            "case_sensitive": false
          },
          "do": "dismiss",
          "target": {
            "primary": {
              "by": "role_name",
              "role": "button",
              "name": "Acknowledge",
              "offset": 1,
              "exact": false
            },
            "fallbacks": []
          },
          "max_attempts": 2,
          "wait_ms": 1000,
          "note": "Interstitial can also appear on this page."
        },
        {
          "when": {
            "kind": "text_present",
            "text": "Your session has expired",
            "case_sensitive": false
          },
          "do": "reauth",
          "max_attempts": 1,
          "wait_ms": 1000
        }
      ],
      "timeout_ms": 10000,
      "retries": 1
    },
    {
      "id": "click_search",
      "intent": "Run the member search and land on the relationship summary",
      "action": "click",
      "target": {
        "primary": {
          "by": "role_name",
          "role": "button",
          "name": "Search",
          "offset": 1,
          "exact": true
        },
        "fallbacks": [
          {
            "by": "css",
            "selector": "input[value='Search']",
            "offset": 1,
            "exact": false
          }
        ],
        "scope": {
          "frame_path": [
            "content"
          ]
        },
        "captured": {
          "role": "button",
          "name": "Search",
          "tag": "input"
        }
      },
      "extract_kind": "text",
      "post_assert": {
        "kind": "text_present",
        "text": "Member Relationship Summary",
        "case_sensitive": false
      },
      "on_error": [
        {
          "when": {
            "kind": "text_present",
            "text": "Server Error in",
            "case_sensitive": false
          },
          "do": "fail",
          "max_attempts": 2,
          "wait_ms": 1000,
          "note": "Core returned an application error rather than a record."
        },
        {
          "when": {
            "kind": "text_present",
            "text": "Your session has expired",
            "case_sensitive": false
          },
          "do": "reauth",
          "max_attempts": 1,
          "wait_ms": 1000
        },
        {
          "when": {
            "kind": "text_present",
            "text": "Scheduled maintenance",
            "case_sensitive": false
          },
          "do": "dismiss",
          "target": {
            "primary": {
              "by": "role_name",
              "role": "button",
              "name": "Acknowledge",
              "offset": 1,
              "exact": false
            },
            "fallbacks": []
          },
          "max_attempts": 2,
          "wait_ms": 1000
        }
      ],
      "timeout_ms": 15000,
      "retries": 1
    },
    {
      "id": "extract_name",
      "intent": "Read the member's name from the summary panel",
      "action": "extract",
      "target": {
        "primary": {
          "by": "text_near",
          "anchor": "Member Name",
          "direction": "right",
          "offset": 1,
          "exact": false
        },
        "fallbacks": [
          {
            "by": "css",
            "selector": "#ctl00_lblMbrName",
            "offset": 1,
            "exact": false
          }
        ],
        "scope": {
          "frame_path": [
            "content"
          ]
        },
        "captured": {
          "role": "generic",
          "name": "",
          "tag": "td"
        }
      },
      "extract_as": "member_name",
      "extract_kind": "text",
      "on_error": [],
      "timeout_ms": 8000,
      "retries": 1
    },
    {
      "id": "extract_balance",
      "intent": "Read the Regular Savings balance from the share accounts grid",
      "action": "extract",
      "target": {
        "primary": {
          "by": "text_near",
          "anchor": "Regular Savings",
          "direction": "right",
          "offset": 2,
          "exact": false
        },
        "fallbacks": [
          {
            "by": "css",
            "selector": "#ctl00_grdAccounts tr:has(td:text-is('Regular Savings')) td:nth-child(4)",
            "offset": 1,
            "exact": false
          }
        ],
        "scope": {
          "frame_path": [
            "content"
          ]
        },
        "captured": {
          "role": "generic",
          "name": "",
          "tag": "td"
        }
      },
      "extract_as": "savings_balance",
      "extract_kind": "text",
      "on_error": [],
      "timeout_ms": 8000,
      "retries": 1
    }
  ],
  "checkpoint": {
    "kind": "text_present",
    "text": "Member Relationship Summary",
    "case_sensitive": false
  },
  "outcomes": [
    {
      "name": "member_not_found",
      "description": "No member exists with the supplied member number.",
      "detect": {
        "kind": "text_present",
        "text": "No member record found",
        "case_sensitive": false
      },
      "detail_from": {
        "primary": {
          "by": "css",
          "selector": "#ctl00_ContentPlaceHolder1_lblNotFound",
          "offset": 1,
          "exact": false
        },
        "fallbacks": []
      }
    },
    {
      "name": "permission_denied",
      "description": "The operating role is not entitled to view this member record.",
      "detect": {
        "kind": "text_present",
        "text": "Access restricted",
        "case_sensitive": false
      },
      "detail_from": {
        "primary": {
          "by": "css",
          "selector": "#ctl00_ContentPlaceHolder1_lblDenied",
          "offset": 1,
          "exact": false
        },
        "fallbacks": []
      }
    }
  ],
  "provenance": {
    "discovered_by": "hand_authored",
    "goal": "Look up member 12345 and read their current savings balance",
    "recorded_at": "2026-09-11T00:00:00Z",
    "evidence_ref": "evidence/README.md"
